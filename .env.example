# Copy to .env and fill in values. .env is gitignored — NEVER commit real values.

# Swarms agent dispatch
SWARMS_DRY_RUN=true                # false to actually send alerts
CRYPTO_FORCE_ALERT=false           # true to test transports without real depeg

# Gmail SMTP (for email transport)
# Create app password at https://myaccount.google.com/apppasswords
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=

# GitHub issue transport
# Local: gh CLI sets GH_TOKEN automatically if authenticated
# GHA: secrets.GITHUB_TOKEN is set by the runner
GH_TOKEN=
GH_REPO=JohnGavin/crypto_swarms

# LLM analysis (optional) — uses `claude -p` subprocess with Max subscription
# Set to 'true' to invoke Claude on triggered alerts. Requires Claude Code CLI
# installed locally and authenticated via `claude /login` (NOT API key).
CRYPTO_LLM_ANALYSIS=false

# Alternative: paid API keys (only needed if NOT using Max subscription via claude -p)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Phase 2: premium data sources (optional, rate-limit relief)
# HELIUS_API_KEY=
# BIRDEYE_API_KEY=
